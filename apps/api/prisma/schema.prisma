generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BillingMode {
  STANDARD
  BYOK
}

enum BillingInterval {
  MONTHLY
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum RepositoryProvider {
  GITHUB
  GITLAB
  BITBUCKET
}

enum RepositoryStatus {
  PENDING
  CLONING
  PARSING
  CHUNKING
  EMBEDDING
  READY
  FAILED
}

enum IndexingRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum IndexingTrigger {
  INITIAL_CONNECT
  MANUAL_RETRY
  MANUAL_REINDEX
}

enum GuideType {
  EXECUTIVE_SUMMARY
  PROJECT_OVERVIEW
  FOLDER
  MODULE
  SERVICE
  TECHNOLOGY_STACK
  READING_ORDER
  GLOSSARY
  COMMON_PITFALLS
}

enum GuideGenerationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum GuideGenerationTrigger {
  INITIAL_INDEX
  MANUAL_GENERATE
  MANUAL_REGENERATE
  REINDEX
}

enum CodeSymbolType {
  FUNCTION
  CLASS
  METHOD
  INTERFACE
  ENUM
  TYPE_ALIAS
  VARIABLE
  CONSTANT
  NAMESPACE
  MODULE
}

enum SymbolRelationType {
  IMPORTS
  EXPORTS
  EXTENDS
  IMPLEMENTS
  CALLS
  USES
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum OAuthProvider {
  GITHUB
}

enum IdentityProvider {
  GOOGLE
  GITHUB
}

enum AnalyticsEventType {
  REPOSITORY_CONNECTED
  REPOSITORY_INDEXING_SUCCEEDED
  REPOSITORY_INDEXING_FAILED
}

enum AnswerFeedbackRating {
  HELPFUL
  NOT_HELPFUL
}

enum SystemLogCategory {
  HTTP
  AUDIT
}

enum SystemLogLevel {
  INFO
  WARN
  ERROR
}

enum UsageMetric {
  REPOSITORIES
  INDEXING_RUNS
  GUIDE_GENERATIONS
  AI_QUESTIONS
  MEMBERS
}

enum UsagePeriod {
  CURRENT
  MONTHLY
}

model User {
  id            String           @id @default(uuid()) @db.Uuid
  email         String           @unique
  passwordHash  String?          @map("password_hash")
  firstName     String           @map("first_name")
  lastName      String           @map("last_name")
  avatarUrl     String?          @map("avatar_url")
  emailVerified Boolean          @default(false) @map("email_verified")
  memberships   Membership[]
  conversations Conversation[]
  answerFeedback AnswerFeedback[]
  connectedRepositories Repository[] @relation("RepositoryConnectedBy")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  deletedAt     DateTime?        @map("deleted_at")
  lastLoginAt   DateTime?        @map("last_login_at")
  oauthAccounts OAuthAccount[]
  identityAccounts IdentityAccount[]

  @@index([createdAt], map: "users_created_at_idx")
  @@map("users")
}

model Admin {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastLoginAt  DateTime? @map("last_login_at")

  @@map("admins")
}

model OAuthAccount {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  provider              OAuthProvider
  providerUserId        String        @map("provider_user_id")
  login                 String
  accessTokenEncrypted  String        @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String?       @map("refresh_token_encrypted") @db.Text
  tokenExpiresAt        DateTime?     @map("token_expires_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider], map: "oauth_accounts_user_id_provider_key")
  @@unique([provider, providerUserId], map: "oauth_accounts_provider_provider_user_id_key")
  @@index([userId], map: "oauth_accounts_user_id_idx")
  @@map("oauth_accounts")
}

model IdentityAccount {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  provider       IdentityProvider
  providerUserId String           @map("provider_user_id")
  email          String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider], map: "identity_accounts_user_id_provider_key")
  @@unique([provider, providerUserId], map: "identity_accounts_provider_provider_user_id_key")
  @@index([userId], map: "identity_accounts_user_id_idx")
  @@map("identity_accounts")
}

model Workspace {
  id                  String                 @id @default(uuid()) @db.Uuid
  name                String
  slug                String                 @unique
  planId              String                 @map("plan_id") @db.Uuid
  plan                Plan                   @relation(fields: [planId], references: [id])
  subscription        WorkspaceSubscription?
  memberships         Membership[]
  invitations         Invitation[]
  repositories        Repository[]
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  deletedAt           DateTime?              @map("deleted_at")
  conversations       Conversation[]
  guides              Guide[]
  guideGenerationRuns GuideGenerationRun[]
  aiSettings          WorkspaceAiSettings?
  aiCredentials       WorkspaceAiCredential[]

  @@index([createdAt], map: "workspaces_created_at_idx")
  @@index([planId], map: "workspaces_plan_id_idx")
  @@map("workspaces")
}

model Plan {
  id              String                   @id @default(uuid()) @db.Uuid
  key             String                   @unique
  name            String
  description     String?
  isContactSales  Boolean                  @default(false) @map("is_contact_sales")
  isActive        Boolean                  @default(true) @map("is_active")
  sortOrder       Int                      @default(0) @map("sort_order")
  stripeProductId String?                  @map("stripe_product_id")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  prices          PlanPrice[]
  limits          PlanLimit[]
  workspaces      Workspace[]
  subscriptions   WorkspaceSubscription[]

  @@map("plans")
}

model PlanPrice {
  id            String          @id @default(uuid()) @db.Uuid
  planId        String          @map("plan_id") @db.Uuid
  billingMode   BillingMode     @map("billing_mode")
  interval      BillingInterval @default(MONTHLY)
  amount        Int
  currency      String          @default("usd")
  stripePriceId String?         @map("stripe_price_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  plan          Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, billingMode, interval], map: "plan_prices_plan_mode_interval_key")
  @@map("plan_prices")
}

model WorkspaceSubscription {
  workspaceId              String             @id @map("workspace_id") @db.Uuid
  planId                   String             @map("plan_id") @db.Uuid
  billingMode              BillingMode        @default(STANDARD) @map("billing_mode")
  status                   SubscriptionStatus @default(ACTIVE)
  stripeCustomerId         String?            @map("stripe_customer_id")
  stripeSubscriptionId     String?            @unique @map("stripe_subscription_id")
  stripeSubscriptionItemId String?            @map("stripe_subscription_item_id")
  currentPeriodEnd         DateTime?          @map("current_period_end")
  cancelAtPeriodEnd        Boolean            @default(false) @map("cancel_at_period_end")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")
  workspace                Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                     Plan               @relation(fields: [planId], references: [id])

  @@index([planId], map: "workspace_subscriptions_plan_id_idx")
  @@map("workspace_subscriptions")
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("stripe_webhook_events")
}

model PlanLimit {
  id        String      @id @default(uuid()) @db.Uuid
  planId    String      @map("plan_id") @db.Uuid
  plan      Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  metric    UsageMetric
  period    UsagePeriod
  maxValue  Int?        @map("max_value")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@unique([planId, metric], map: "plan_limits_plan_id_metric_key")
  @@map("plan_limits")
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GROK
  GEMINI
}

model WorkspaceAiSettings {
  workspaceId    String      @id @map("workspace_id") @db.Uuid
  activeProvider AiProvider? @map("active_provider")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_ai_settings")
}

model WorkspaceAiCredential {
  id                String     @id @default(uuid()) @db.Uuid
  workspaceId       String     @map("workspace_id") @db.Uuid
  provider          AiProvider
  apiKeyEncrypted   String     @map("api_key_encrypted") @db.Text
  keyLast4          String     @map("key_last4") @db.VarChar(4)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  workspace         Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider], map: "workspace_ai_credentials_workspace_id_provider_key")
  @@map("workspace_ai_credentials")
}

model Membership {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  role        WorkspaceRole
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now()) @map("joined_at")
  lastSeenAt  DateTime?        @map("last_seen_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId], map: "memberships_workspace_id_user_id_key")
  @@index([userId], map: "memberships_user_id_idx")
  @@index([workspaceId, status], map: "memberships_workspace_id_status_idx")
  @@map("memberships")
}

model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  email       String
  role        WorkspaceRole
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  acceptedAt  DateTime?        @map("accepted_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email], map: "invitations_workspace_id_email_idx")
  @@map("invitations")
}

model Repository {
  id                  String               @id @default(uuid()) @db.Uuid
  workspaceId         String               @db.Uuid
  provider            RepositoryProvider
  externalId          String
  owner               String
  name                String
  fullName            String
  defaultBranch       String
  status              RepositoryStatus
  lastIndexedAt       DateTime?
  indexingError       String?
  connectedByUserId   String?              @map("connected_by_user_id") @db.Uuid
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy         User?                @relation("RepositoryConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)
  conversations       Conversation[]
  indexingRuns        IndexingRun[]
  files               RepositoryFile[]
  symbols             CodeSymbol[]
  symbolRelations     SymbolRelation[]
  chunks              Chunk[]
  guides              Guide[]
  guideGenerationRuns GuideGenerationRun[]

  @@unique([provider, externalId])
  @@index([workspaceId])
  @@index([connectedByUserId])
  @@map("repositories")
}

model Guide {
  id                  String     @id @default(uuid()) @db.Uuid
  workspaceId         String     @db.Uuid
  repositoryId        String     @db.Uuid
  type                GuideType
  slug                String
  title               String
  markdown            String     @db.Text
  summary             String?    @db.Text
  metadata            Json
  generationVersion   Int        @default(1)
  sourceIndexingRunId String?    @db.Uuid
  sourceCommitSha     String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  workspace           Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository          Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, type, slug], map: "guides_repository_id_type_slug_key")
  @@index([workspaceId, repositoryId], map: "guides_workspace_id_repository_id_idx")
  @@index([repositoryId, type], map: "guides_repository_id_type_idx")
  @@map("guides")
}

model GuideGenerationRun {
  id                  String                 @id @default(uuid()) @db.Uuid
  workspaceId         String                 @db.Uuid
  repositoryId        String                 @db.Uuid
  trigger             GuideGenerationTrigger
  status              GuideGenerationStatus  @default(QUEUED)
  requestedTypes      GuideType[]
  totalGuideCount     Int                    @default(0)
  completedGuideCount Int                    @default(0)
  sourceIndexingRunId String?                @db.Uuid
  sourceCommitSha     String?
  error               String?                @db.Text
  errors              Json?
  createdAt           DateTime               @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  updatedAt           DateTime               @updatedAt
  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository          Repository             @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([workspaceId, repositoryId], map: "guide_generation_runs_workspace_repository_idx")
  @@index([repositoryId, status, createdAt], map: "guide_generation_runs_repository_status_created_idx")
  @@map("guide_generation_runs")
}

model IndexingRun {
  id                   String            @id @default(uuid()) @db.Uuid
  repositoryId         String            @db.Uuid
  trigger              IndexingTrigger
  status               IndexingRunStatus
  branch               String?
  commitSha            String?
  clonePath            String?
  supportedFileCount   Int               @default(0)
  ignoredFileCount     Int               @default(0)
  symbolCount          Int               @default(0)
  chunkCount           Int               @default(0)
  embeddingCount       Int               @default(0)
  processingDurationMs Int?              @map("processing_duration_ms")
  error                String?
  errors               Json?
  startedAt            DateTime          @default(now())
  completedAt          DateTime?
  repository           Repository        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  files                RepositoryFile[]
  symbols              CodeSymbol[]
  symbolRelations      SymbolRelation[]
  chunks               Chunk[]

  @@index([repositoryId])
  @@index([status])
  @@map("indexing_runs")
}

model RepositoryFile {
  id            String       @id @default(uuid()) @db.Uuid
  repositoryId  String       @db.Uuid
  indexingRunId String       @db.Uuid
  path          String
  language      String
  contentHash   String
  size          Int
  lineCount     Int          @map("line_count")
  extension     String
  generated     Boolean      @default(false)
  ignored       Boolean      @default(false)
  binary        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  repository    Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  indexingRun   IndexingRun  @relation(fields: [indexingRunId], references: [id], onDelete: Cascade)
  symbols       CodeSymbol[]
  chunks        Chunk[]

  @@unique([repositoryId, path], map: "repository_files_repository_id_path_key")
  @@index([repositoryId])
  @@index([indexingRunId])
  @@map("repository_files")
}

model CodeSymbol {
  id             String           @id @default(uuid()) @db.Uuid
  repositoryId   String           @db.Uuid
  indexingRunId  String           @db.Uuid
  fileId         String?          @db.Uuid
  filePath       String
  type           CodeSymbolType
  name           String
  qualifiedName  String           @map("qualified_name")
  language       String
  startLine      Int
  endLine        Int
  startColumn    Int              @map("start_column")
  endColumn      Int              @map("end_column")
  exported       Boolean          @default(false)
  isAsync        Boolean          @default(false) @map("is_async")
  isStatic       Boolean          @default(false) @map("is_static")
  visibility     String           @default("default")
  parentSymbolId String?          @map("parent_symbol_id") @db.Uuid
  createdAt      DateTime         @default(now())
  repository     Repository       @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  indexingRun    IndexingRun      @relation(fields: [indexingRunId], references: [id], onDelete: Cascade)
  file           RepositoryFile?  @relation(fields: [fileId], references: [id], onDelete: SetNull)
  parentSymbol   CodeSymbol?      @relation("CodeSymbolParentChild", fields: [parentSymbolId], references: [id], onDelete: SetNull)
  childSymbols   CodeSymbol[]     @relation("CodeSymbolParentChild")
  relationsFrom  SymbolRelation[] @relation("SymbolRelationFrom")
  relationsTo    SymbolRelation[] @relation("SymbolRelationTo")
  chunks         Chunk[]

  @@index([repositoryId])
  @@index([indexingRunId])
  @@index([filePath])
  @@index([qualifiedName])
  @@index([parentSymbolId])
  @@map("code_symbols")
}

model Chunk {
  id             String          @id @default(uuid()) @db.Uuid
  repositoryId   String          @db.Uuid
  indexingRunId  String          @db.Uuid
  fileId         String?         @db.Uuid
  symbolId       String?         @db.Uuid
  filePath       String
  content        String          @db.Text
  tokenCount     Int
  startLine      Int?
  endLine        Int?
  metadata       Json?
  vectorId       String?
  language       String?
  embeddingModel String?
  createdAt      DateTime        @default(now())
  repository     Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  indexingRun    IndexingRun     @relation(fields: [indexingRunId], references: [id], onDelete: Cascade)
  file           RepositoryFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  symbol         CodeSymbol?     @relation(fields: [symbolId], references: [id], onDelete: SetNull)

  @@index([repositoryId])
  @@index([indexingRunId])
  @@index([symbolId])
  @@map("chunks")
}

model SymbolRelation {
  id                  String             @id @default(uuid()) @db.Uuid
  repositoryId        String             @db.Uuid
  indexingRunId       String             @db.Uuid
  fromSymbolId        String             @map("from_symbol_id") @db.Uuid
  toSymbolId          String?            @map("to_symbol_id") @db.Uuid
  relationType        SymbolRelationType @map("relation_type")
  targetQualifiedName String?            @map("target_qualified_name")
  targetFilePath      String?            @map("target_file_path")
  createdAt           DateTime           @default(now()) @map("created_at")
  repository          Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  indexingRun         IndexingRun        @relation(fields: [indexingRunId], references: [id], onDelete: Cascade)
  fromSymbol          CodeSymbol         @relation("SymbolRelationFrom", fields: [fromSymbolId], references: [id], onDelete: Cascade)
  toSymbol            CodeSymbol?        @relation("SymbolRelationTo", fields: [toSymbolId], references: [id], onDelete: SetNull)

  @@index([repositoryId, indexingRunId], map: "symbol_relations_repository_run_idx")
  @@index([fromSymbolId], map: "symbol_relations_from_symbol_idx")
  @@index([toSymbolId], map: "symbol_relations_to_symbol_idx")
  @@index([relationType], map: "symbol_relations_relation_type_idx")
  @@map("symbol_relations")
}

model Conversation {
  id           String      @id @default(uuid()) @db.Uuid
  workspaceId  String      @db.Uuid
  repositoryId String?     @db.Uuid
  createdById  String      @db.Uuid
  title        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository   Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  createdBy    User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([workspaceId])
  @@index([repositoryId])
  @@index([createdById])
  @@map("conversations")
}

model Message {
  id             String                  @id @default(uuid()) @db.Uuid
  conversationId String                  @db.Uuid
  role           MessageRole
  content        String                  @db.Text
  metadata       Json?
  createdAt      DateTime                @default(now())
  conversation   Conversation            @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceCitations MessageSourceCitation[]
  answerFeedback  AnswerFeedback[]

  @@index([conversationId])
  @@index([role, createdAt])
  @@map("messages")
}

model AnalyticsEvent {
  id           String             @id @default(uuid()) @db.Uuid
  type         AnalyticsEventType
  workspaceId  String             @map("workspace_id") @db.Uuid
  actorUserId  String?            @map("actor_user_id") @db.Uuid
  repositoryId String?            @map("repository_id") @db.Uuid
  payload      Json?
  createdAt    DateTime           @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([workspaceId, createdAt])
  @@map("analytics_events")
}

model MessageSourceCitation {
  id             String   @id @default(uuid()) @db.Uuid
  messageId      String   @map("message_id") @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  repositoryId   String   @map("repository_id") @db.Uuid
  chunkId        String   @map("chunk_id") @db.Uuid
  filePath       String   @map("file_path")
  startLine      Int?     @map("start_line")
  endLine        Int?     @map("end_line")
  score          Float
  rank           Int
  createdAt      DateTime @default(now()) @map("created_at")
  message        Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([repositoryId, filePath])
  @@index([messageId])
  @@map("message_source_citations")
}

model AnswerFeedback {
  id             String               @id @default(uuid()) @db.Uuid
  workspaceId    String               @map("workspace_id") @db.Uuid
  conversationId String               @map("conversation_id") @db.Uuid
  messageId      String               @map("message_id") @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  rating         AnswerFeedbackRating
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  message        Message              @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([workspaceId, createdAt])
  @@map("answer_feedback")
}

model SystemLog {
  id           String            @id @default(uuid()) @db.Uuid
  category     SystemLogCategory
  level        SystemLogLevel    @default(INFO)
  event        String
  message      String?
  requestId    String?           @map("request_id")
  actorType    String?           @map("actor_type")
  actorId      String?           @map("actor_id") @db.Uuid
  workspaceId  String?           @map("workspace_id") @db.Uuid
  repositoryId String?           @map("repository_id") @db.Uuid
  method       String?
  route        String?
  statusCode   Int?              @map("status_code")
  latencyMs    Int?              @map("latency_ms")
  metadata     Json?
  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([level, createdAt])
  @@index([event, createdAt])
  @@index([requestId])
  @@map("system_logs")
}
