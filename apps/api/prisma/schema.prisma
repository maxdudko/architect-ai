generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspacePlan {
  FREE
  PRO
  ENTERPRISE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum RepositoryProvider {
  GITHUB
  GITLAB
  BITBUCKET
}

enum RepositoryStatus {
  PENDING
  CLONING
  PARSING
  EMBEDDING
  READY
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum OAuthProvider {
  GITHUB
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  email         String       @unique
  passwordHash  String       @map("password_hash")
  firstName     String       @map("first_name")
  lastName      String       @map("last_name")
  avatarUrl     String?      @map("avatar_url")
  emailVerified Boolean      @default(false) @map("email_verified")
  memberships   Membership[]
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")
  lastLoginAt   DateTime?    @map("last_login_at")
  oauthAccounts OAuthAccount[]

  @@index([createdAt], map: "users_created_at_idx")
  @@map("users")
}

model OAuthAccount {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  provider              OAuthProvider
  providerUserId        String        @map("provider_user_id")
  login                 String
  accessTokenEncrypted  String        @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String?       @map("refresh_token_encrypted") @db.Text
  tokenExpiresAt        DateTime?     @map("token_expires_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider], map: "oauth_accounts_user_id_provider_key")
  @@unique([provider, providerUserId], map: "oauth_accounts_provider_provider_user_id_key")
  @@index([userId], map: "oauth_accounts_user_id_idx")
  @@map("oauth_accounts")
}

model Workspace {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  slug          String         @unique
  plan          WorkspacePlan  @default(FREE)
  memberships   Membership[]
  invitations   Invitation[]
  repositories  Repository[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")
  conversations Conversation[]

  @@index([createdAt], map: "workspaces_created_at_idx")
  @@map("workspaces")
}

model Membership {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  role        WorkspaceRole
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now()) @map("joined_at")
  lastSeenAt  DateTime?        @map("last_seen_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId], map: "memberships_workspace_id_user_id_key")
  @@index([userId], map: "memberships_user_id_idx")
  @@index([workspaceId, status], map: "memberships_workspace_id_status_idx")
  @@map("memberships")
}

model Invitation {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  email       String
  role        WorkspaceRole
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  acceptedAt  DateTime?        @map("accepted_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email], map: "invitations_workspace_id_email_idx")
  @@map("invitations")
}

model Repository {
  id            String             @id @default(uuid()) @db.Uuid
  workspaceId   String             @db.Uuid
  provider      RepositoryProvider
  externalId    String
  owner         String
  name          String
  fullName      String
  defaultBranch String
  status        RepositoryStatus
  lastIndexedAt DateTime?
  indexingError String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([provider, externalId])
  @@index([workspaceId])
  @@map("repositories")
}

model Conversation {
  id           String      @id @default(uuid()) @db.Uuid
  workspaceId  String      @db.Uuid
  repositoryId String?     @db.Uuid
  createdById  String      @db.Uuid
  title        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repository   Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  // createdBy User @relation(fields: [createdById], references: id[])
  messages     Message[]

  @@index([workspaceId])
  @@index([repositoryId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  role           MessageRole
  content        String       @db.Text
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}
