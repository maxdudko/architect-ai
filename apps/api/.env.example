DATABASE_URL="postgresql://architect-ai-user:architect-ai-password@localhost:5433/architect-ai-db?schema=public"
# Dedicated database for e2e tests. These tests TRUNCATE every table, so this
# MUST point at a throwaway database whose name contains "test" and NEVER at
# your working DATABASE_URL above. When set, it overrides DATABASE_URL for e2e.
TEST_DATABASE_URL="postgresql://architect-ai-user:architect-ai-password@localhost:5433/architect-ai-test-db?schema=public"
JWT_ACCESS_SECRET="replace-with-strong-access-secret"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
REDIS_URL="redis://localhost:6380"
QDRANT_URL="http://localhost:6335"
QDRANT_COLLECTION="architect_chunks"
INDEXING_WORKER_ENABLED="false"
INDEXING_WORKER_CONCURRENCY="2"
INDEXING_TMP_DIR="/tmp/architect-ai/indexing"
INDEXING_TMP_STALE_MINUTES="120"
INDEXING_MAX_CLONE_BYTES="1000000000"
EMBEDDING_PROVIDER="mock"
EMBEDDING_MODEL="hash-embedding-v1"
EMBEDDING_DIMENSIONS="1536"
EMBEDDING_BATCH_SIZE="64"
OPENAI_API_KEY=""
OPENAI_API_BASE_URL="https://api.openai.com/v1"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
RETRIEVAL_CACHE_DRIVER="redis"
RETRIEVAL_CACHE_PREFIX="architect:retrieval:"
RETRIEVAL_CONTEXT_CACHE_TTL_SECONDS="300"
RETRIEVAL_QUERY_EMBEDDING_CACHE_TTL_SECONDS="3600"
QDRANT_UPSERT_BATCH_SIZE="128"
COOKIE_DOMAIN=""
PORT=5000
CORS_ORIGINS="http://localhost:3000"
WEB_URL="http://localhost:3000"
RESEND_API_KEY=""
MAIL_FROM="Architect AI <onboarding@resend.dev>"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_OAUTH_REDIRECT_URI="http://localhost:5000/integrations/github/callback"
TOKEN_ENCRYPTION_KEY="replace-with-32-byte-minimum-secret"
GITHUB_OAUTH_STATE_SECRET="replace-with-strong-random-secret"
