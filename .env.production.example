# Copy to .env.production on the EC2 host and replace every CHANGE_ME value.
# Load with:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
# Do not commit .env.production.

# ==============================================================================
# Public Hostnames & TLS (Caddy)
# ==============================================================================
# Hostnames only — no scheme. Used by Caddy for HTTPS and ACME.
APP_HOST=app.example.com
API_HOST=api.example.com
ACME_EMAIL=ops@example.com

# ==============================================================================
# URLs & CORS
# ==============================================================================
WEB_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
# Shared cookie domain for app + api hosts (leading dot).
COOKIE_DOMAIN=.example.com
# All NEXT_PUBLIC_* values are baked into the web image at build time.
# Changing them later requires: docker compose ... up -d --build web

# ==============================================================================
# Database (PostgreSQL)
# ==============================================================================
POSTGRES_DB=architect-ai-db
POSTGRES_USER=architect-ai-user
# URL-safe only. Generate with: openssl rand -hex 32
# Do not use base64 here — characters like / + = break the DB URL.
POSTGRES_PASSWORD=CHANGE_ME_HEX
# Compose overrides this from POSTGRES_* so it cannot drift from the server password.
DATABASE_URL=postgresql://architect-ai-user:CHANGE_ME_HEX@postgres:5432/architect-ai-db?schema=public

# ==============================================================================
# Redis (Cache, Sessions & Queues)
# ==============================================================================
REDIS_URL=redis://redis:6379
RETRIEVAL_CACHE_DRIVER=redis
RETRIEVAL_CACHE_PREFIX=architect:retrieval:
RETRIEVAL_CONTEXT_CACHE_TTL_SECONDS=300
RETRIEVAL_QUERY_EMBEDDING_CACHE_TTL_SECONDS=3600

# ==============================================================================
# Qdrant (Vector Database)
# ==============================================================================
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=architect_chunks
QDRANT_UPSERT_BATCH_SIZE=128

# ==============================================================================
# Repository Indexing & Worker
# ==============================================================================
INDEXING_WORKER_CONCURRENCY=2
INDEXING_TMP_DIR=/tmp/architect-ai/indexing
INDEXING_TMP_STALE_MINUTES=120
INDEXING_MAX_CLONE_BYTES=1000000000
# Keep worker job locks longer than slow clone/parse stages (default: max(2x clone timeout, 30m))
INDEXING_CLONE_TIMEOUT_MS=120000
INDEXING_JOB_LOCK_DURATION_MS=1800000
REPOSITORY_ACCESS_VALIDATION_ENABLED=true

# ==============================================================================
# Onboarding Guide Worker
# ==============================================================================
# Inherits INDEXING_WORKER_ENABLED when unset (API=false, worker=true).
# ONBOARDING_WORKER_ENABLED=true
ONBOARDING_WORKER_CONCURRENCY=1
ONBOARDING_JOB_LOCK_DURATION_MS=1800000
ONBOARDING_QUEUE_READY_TIMEOUT_MS=5000

# ==============================================================================
# AI & Embedding Providers
# ==============================================================================
# Do not use mock in production.
# EMBEDDING_PROVIDER: openai (OPENAI_API_KEY is required for embeddings even if LLM_PROVIDER is not openai)
EMBEDDING_PROVIDER=openai
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_BASE_URL=https://api.openai.com/v1

# LLM_PROVIDER: openai | anthropic | grok | gemini
LLM_PROVIDER=anthropic
LLM_MAX_TOKENS=2048
OPENAI_API_KEY=CHANGE_ME
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GROK_API_KEY=
GROK_MODEL=grok-4.6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# Authentication & JWT Tokens
# ==============================================================================
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

JWT_ADMIN_ACCESS_SECRET=CHANGE_ME
JWT_ADMIN_REFRESH_SECRET=CHANGE_ME
JWT_ADMIN_ACCESS_TTL=15m
JWT_ADMIN_REFRESH_TTL=30d

# ==============================================================================
# Security & Encryption Secrets
# ==============================================================================
TOKEN_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_MINIMUM_SECRET
GITHUB_OAUTH_STATE_SECRET=CHANGE_ME
AUTH_OAUTH_STATE_SECRET=CHANGE_ME

# ==============================================================================
# GitHub Integration OAuth (Repository Access)
# ==============================================================================
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
GITHUB_OAUTH_REDIRECT_URI=https://api.example.com/integrations/github/callback

# ==============================================================================
# Identity OAuth (User Sign-in / Sign-up)
# ==============================================================================
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/auth/oauth/google/callback

AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_OAUTH_REDIRECT_URI=https://api.example.com/auth/oauth/github/callback

NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true
NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=true

# ==============================================================================
# Billing (Stripe)
# ==============================================================================
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME

# ==============================================================================
# Email & Contact (Resend)
# ==============================================================================
# Required for contact-form and invitation emails (https://resend.com/api-keys)
RESEND_API_KEY=CHANGE_ME
MAIL_FROM='Architect AI <noreply@example.com>'
CONTACT_TO_EMAIL=sales@architect.ai

# ==============================================================================
# Landing Page & Creator Links
# ==============================================================================
CREATOR_SITE_URL=https://example.com
CREATOR_LINKEDIN_URL=https://www.linkedin.com/in/example/
GITHUB_REPO_URL=https://github.com/example/architect-ai

# ==============================================================================
# Rate Limiting
# ==============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_LIMIT=120
RATE_LIMIT_DEFAULT_WINDOW_MS=60000

# ==============================================================================
# Monitoring & Observability (Sentry)
# ==============================================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
