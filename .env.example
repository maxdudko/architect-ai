POSTGRES_DB=architect-ai-db
POSTGRES_USER=architect-ai-user
POSTGRES_PASSWORD=architect-ai-password
POSTGRES_PORT=5433

REDIS_PORT=6380

QDRANT_HTTP_PORT=6335
QDRANT_GRPC_PORT=6336

API_PORT=5000
WEB_PORT=3000

# Host apps / Prisma CLI (published Postgres port). Containers ignore this and use DOCKER_DATABASE_URL.
DATABASE_URL=postgresql://architect-ai-user:architect-ai-password@localhost:5433/architect-ai-db?schema=public
# Injected into api + indexing-worker via docker-compose (Docker network hostname).
DOCKER_DATABASE_URL=postgresql://architect-ai-user:architect-ai-password@postgres:5432/architect-ai-db
REDIS_URL=redis://redis:6379
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=architect_chunks
INDEXING_WORKER_CONCURRENCY=2
INDEXING_TMP_DIR=/tmp/architect-ai/indexing
INDEXING_TMP_STALE_MINUTES=120
INDEXING_MAX_CLONE_BYTES=1000000000
# Keep worker job locks longer than slow clone/parse stages (default: max(2x clone timeout, 30m))
# INDEXING_JOB_LOCK_DURATION_MS=1800000
# INDEXING_CLONE_TIMEOUT_MS=120000
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LLM_PROVIDER: mock | anthropic | openai | grok | gemini
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_CHAT_MODEL=gpt-4o-mini
GROK_API_KEY=
GROK_MODEL=grok-4.6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_MAX_TOKENS=2048
RETRIEVAL_CACHE_DRIVER=redis
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000

CREATOR_SITE_URL=https://maxdudko.vercel.app/
CREATOR_LINKEDIN_URL=https://www.linkedin.com/in/maxdudko/
GITHUB_REPO_URL=https://github.com/maxdudko/architect-ai

WEB_URL=http://localhost:3000
# Required for contact-form and invitation emails (https://resend.com/api-keys)
RESEND_API_KEY=
MAIL_FROM='Architect AI <onboarding@resend.dev>'
CONTACT_TO_EMAIL=sales@architect.ai
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5000/integrations/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/auth/oauth/google/callback
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_OAUTH_REDIRECT_URI=http://localhost:5000/auth/oauth/github/callback
AUTH_OAUTH_STATE_SECRET=
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=true
NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=true
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-minimum-secret
GITHUB_OAUTH_STATE_SECRET=replace-with-strong-random-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
