flowchart TD
  connect[User connects repository] --> createPost["POST /workspaces/:id/repositories"]
  createPost --> createSvc[RepositoriesService.createRepository]
  createSvc --> pending[Repository status PENDING]
  createSvc --> enqueueReindex[Enqueue BullMQ job reindex]

  enqueueReindex --> processReindex[Worker processReindex]
  processReindex --> createRun[Create IndexingRun RUNNING]
  processReindex --> setCloning[Set repository status CLONING]
  processReindex --> keepLive[Do not delete live index artifacts]
  processReindex --> enqueueClone[Enqueue clone]

  enqueueClone --> processClone[Worker processClone]
  processClone --> gitClone["git clone --depth 1"]
  gitClone --> setParsing[Set status PARSING]
  setParsing --> enqueueParse[Enqueue parse]

  enqueueParse --> processParse[Worker processParse]
  processParse --> extractSymbols[Walk files extract symbols and relations]
  extractSymbols --> setChunking[Set status CHUNKING]
  setChunking --> enqueueChunk[Enqueue chunk]

  enqueueChunk --> processChunk[Worker processChunk]
  processChunk --> createChunks[Create chunks for this IndexingRun]
  createChunks --> setEmbedding[Set status EMBEDDING]
  setEmbedding --> enqueueEmbed[Enqueue embed]

  enqueueEmbed --> processEmbed[Worker processEmbed]
  processEmbed --> generateEmbeddings[Generate embeddings]
  generateEmbeddings --> upsertQdrant[Upsert vectors in Qdrant]
  upsertQdrant --> runSucceeded[Set IndexingRun SUCCEEDED]
  runSucceeded --> repoReady[Set repository READY and lastIndexedAt]
  repoReady --> swapLive[Delete previous generation Postgres artifacts and Qdrant vectors]
  swapLive --> enqueueGuides[Enqueue onboarding-guide generation]

  terminalFail[Terminal retry exhaustion] --> failRun[Mark IndexingRun FAILED]
  failRun --> maybeReady{Prior SUCCEEDED run exists}
  maybeReady -->|yes| restoreReady[Restore repository READY with indexingError]
  maybeReady -->|no| repoFailed[Set repository FAILED with indexingError]
